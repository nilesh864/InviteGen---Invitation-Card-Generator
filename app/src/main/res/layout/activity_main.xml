<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".MainActivity">

    <!-- Decorative Top Background -->
    <View
        android:id="@+id/topView"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#6C63FF"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header Content -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="InviteGen"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create stunning invitations\nin just a few taps."
            android:textColor="#E0E0E0"
            android:textSize="18sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Main Options Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/optionsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What's the occasion?"
                        android:textColor="#1A1A1A"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="24dp" />

                    <!-- Birthday Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBirthday"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="Birthday Bash"
                        android:textSize="17sp"
                        app:icon="@android:drawable/ic_menu_today"
                        app:iconGravity="textStart"
                        app:cornerRadius="16dp"
                        android:layout_marginBottom="16dp"
                        app:backgroundTint="#FFF0F0"
                        android:textColor="#FF5252"
                        app:iconTint="#FF5252" />

                    <!-- Wedding Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWedding"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="Wedding Vows"
                        android:textSize="17sp"
                        app:icon="@android:drawable/btn_star_big_on"
                        app:iconGravity="textStart"
                        app:cornerRadius="16dp"
                        android:layout_marginBottom="16dp"
                        app:backgroundTint="#F0F4FF"
                        android:textColor="#6C63FF"
                        app:iconTint="#6C63FF" />

                    <!-- Engagement Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEngagement"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="Engagement Party"
                        android:textSize="17sp"
                        app:icon="@android:drawable/ic_menu_camera"
                        app:iconGravity="textStart"
                        app:cornerRadius="16dp"
                        android:layout_marginBottom="16dp"
                        app:backgroundTint="#F0FFF4"
                        android:textColor="#2E7D32"
                        app:iconTint="#2E7D32" />

                    <!-- Custom Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCustom"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="Custom Event"
                        android:textSize="17sp"
                        app:icon="@android:drawable/ic_input_add"
                        app:iconGravity="textStart"
                        app:cornerRadius="16dp"
                        app:backgroundTint="#FFF7E0"
                        android:textColor="#F57C00"
                        app:iconTint="#F57C00" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dashboard Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDashboard"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="View Analytics"
                app:icon="@android:drawable/ic_menu_report_image"
                app:layout_constraintTop_toBottomOf="@id/optionsCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Footer Placeholder -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="InviteGen • Crafted for Celebrations"
                android:textColor="#BDBDBD"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@id/btnDashboard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>